# Large regenerable binaries and scratch output. Small result artifacts are
# whitelisted below so the branch is self-contained when shared.
*.pkg
runs_smoke/
smoke_out*/
logs/

runs/*
!runs/comparison.csv
!runs/epoch_trajectory.csv
!runs/provenance.json
!runs/*_fit.tsv
!runs/*_raw.csv.gz

runs_v1_20epochs/*
!runs_v1_20epochs/comparison.csv
!runs_v1_20epochs/provenance.json
!runs_v1_20epochs/*_fit.tsv
!runs_v1_20epochs/*_raw.csv.gz
